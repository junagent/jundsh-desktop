{
  "name": "jundsh-desktop",
  "productName": "JUNDSH",
  "version": "1.5.0",
  "description": "JUNDSH — 黑色鲸鱼标志的 DSH 桌面客户端",
  "main": "src/main.js",
  "author": "JUNDSH",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/gen-icons.mjs",
    "branding": "electron scripts/gen-branding.mjs",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/float-preload.js && node --check src/shell.js && node --check src/float.js && node --check src/atom.js && node --check src/splash.js && node --check src/settings-schema.js && node --check src/unread.js && node --check src/debug-harness.js && node --check src/dsh-svc.js && node --check src/diag.js && node --check scripts/gen-icons.mjs && node --check scripts/gen-branding.mjs && node --check scripts/smoke-dsh-svc.js",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "smoke": "node scripts/smoke-dsh-svc.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.jundsh.desktop",
    "productName": "JUNDSH",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "junagent",
      "repo": "jundsh-desktop",
      "releaseType": "release"
    },
    "files": [
      "src/**",
      "assets/**",
      "build/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JUNDSH",
      "artifactName": "JUNDSH-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "JUNDSH-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
